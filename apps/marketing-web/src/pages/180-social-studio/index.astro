---
import Layout from '../../layouts/Layout.astro';
import AppHero from '../../components/apps/AppHero.astro';
import CapabilityPillars from '../../components/apps/CapabilityPillars.astro';
import VideoPlaybook from '../../components/apps/VideoPlaybook.astro';
import WorkGraphSynergy from '../../components/apps/WorkGraphSynergy.astro';
import FAQAccordion from '../../components/apps/FAQAccordion.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';
import ProductEcosystemBacklinks from '../../components/seo/ProductEcosystemBacklinks.astro';

const pillars = [
  {
    badge: ">500 FPS Export",
    title: "Lossless Smart Stream-Copy Video Engine",
    description: "Export full-resolution video segments at raw NVMe disk throughput without generational quality loss. Untouched keyframe GOP packets are stream-copied directly, re-encoding only active transition cuts.",
    bullets: [
      "Stream-copy untouched keyframe GOP packets directly",
      "500+ FPS export throughput on standard NVMe SSDs",
      "Exact GOP boundary calculation with zero audio desync"
    ]
  },
  {
    badge: "Mobile Teleprompter",
    title: "Native Mobile Studio with Smart Teleprompter",
    description: "Record camera-ready videos directly from your smartphone. The built-in Flutter mobile teleprompter automatically matches scrolling speed to your speaking voice with AI eye-contact correction.",
    bullets: [
      "Voice-paced scrolling automatically pauses when you pause",
      "Front-facing 4K recording with eye-contact tracking",
      "Instant sync to desktop timeline with zero cable transfers"
    ]
  },
  {
    badge: "Auto-DM Funnel",
    title: "Viral Comment-to-Lead Auto-DM Automation",
    description: "Convert social engagement into paying customers automatically. When viewers comment keywords on your Instagram Reels or X posts, Social Studio immediately DMs them the link and captures the lead into 180 CRM.",
    bullets: [
      "Official Meta Graph API webhook listeners with zero ban risk",
      "Instant customized DM delivery with dynamic tracking links",
      "Direct lead creation in 180 CRM with campaign attribution"
    ]
  },
  {
    badge: "8-Agent Autopilot",
    title: "AI Script Director & Retention Architecture",
    description: "Multi-model creative kernel (Claude, GPT, Gemini) analyzes trending hooks and structures high-retention video scripts complete with scene breakdowns and automated Pexels/Unsplash B-roll sourcing.",
    bullets: [
      "Hook scoring engine targeting sub-3s retention thresholds",
      "Automated scene-by-scene B-roll suggestions and stock matching",
      "100% offline fallback mode with built-in heuristic director"
    ]
  },
  {
    badge: "Omnichannel",
    title: "Visual Multi-Network Publishing Calendar",
    description: "Plan, draft, and schedule all your marketing content across social channels in an intuitive drag-and-drop calendar with real-time live preview mockups for every platform.",
    bullets: [
      "Direct API publishing to YouTube (Shorts), Instagram, X, LinkedIn & Meta",
      "Platform-specific character counters, hashtag helpers & aspect ratios",
      "First-comment auto-posting for links and conversion calls-to-action"
    ]
  },
  {
    badge: "Client Approval",
    title: "Agency Review Workflows & Brand Voice RAG",
    description: "Prevent accidental social slip-ups. Draft posts require client or marketing director sign-off via shareable one-click approval links, while RAG memory enforces strict brand voice guidelines.",
    bullets: [
      "Draft, Pending Review, Scheduled, and Published state machine",
      "External client approval links for agency social managers",
      "Brand voice vector memory ensuring consistent copy tone"
    ]
  }
];

const playbookSteps = [
  {
    stepNumber: "01",
    title: "Generate Viral Scripts with AI Director",
    description: "Enter your topic or product link. The 8-Agent Director researches trending angles, writes a high-hook script, and generates scene-by-scene visual cues.",
    actionSnippet: "AI Director -> Hook Generator -> 60s Reel Script"
  },
  {
    stepNumber: "02",
    title: "Record with Voice-Paced Mobile Teleprompter",
    description: "Open the 180 Social Studio mobile app on your phone. Read from the smart teleprompter that scrolls at your natural cadence while recording in 4K.",
    actionSnippet: "Mobile App -> In-App Teleprompter -> Auto-Scroll"
  },
  {
    stepNumber: "03",
    title: "Auto-Cut & Caption at >500 FPS",
    description: "Import footage into the timeline. The stream-copy engine cuts dead air, burns animated kinetic subtitles, and renders final video at raw SSD read/write speeds.",
    actionSnippet: "Render Engine: >500 FPS Lossless Stream Copy"
  },
  {
    stepNumber: "04",
    title: "Schedule & Launch Auto-DM Lead Capture",
    description: "Schedule across YouTube, Instagram, X, and LinkedIn. Turn on Auto-DM so anyone commenting on your video receives your link and is logged in 180 CRM.",
    actionSnippet: "Auto-DM: Comment 'GUIDE' -> Instant DM + CRM Contact"
  }
];

const synergies = [
  {
    sourceApp: "180 Social Studio",
    targetApp: "180 CRM & Sales",
    badge: "Auto-DM Leads",
    description: "Viewers who comment on social reels automatically receive DM links and are instantly added to your CRM pipeline as qualified leads."
  },
  {
    sourceApp: "180 Social Studio",
    targetApp: "180 Traffic Director",
    badge: "Ad Shielding",
    description: "Bio links and social campaign URLs run through Traffic Director edge routing to mitigate competitor bots and preserve click quality."
  },
  {
    sourceApp: "180 Social Studio",
    targetApp: "Workspace Cloud Drive",
    badge: "Zero-Egress Assets",
    description: "Direct asset pipeline with 180 Cloud Drive for high-resolution video b-roll, logos, and creator media libraries."
  }
];

const faqs = [
  {
    question: "What makes 180 Social Studio different from traditional video editors?",
    answer: "Traditional editors (Premiere, CapCut) re-encode every single pixel upon export, causing long rendering times and generational compression artifacts. 180 Social Studio utilizes a smart stream-copy engine that copies untouched keyframe GOP packets directly from disk, re-encoding only modified cut boundaries to deliver export speeds exceeding 500 FPS."
  },
  {
    question: "Is there a dedicated mobile app for recording and scripting?",
    answer: "Yes! 180 Social Studio includes a native Flutter mobile app for Android and iOS. It features a smart voice-paced teleprompter that tracks your speech in real time, camera recording with eye-contact correction, and instant cloud sync to your desktop timeline."
  },
  {
    question: "How does the Auto-DM comment automation work?",
    answer: "Social Studio integrates directly with official Meta and X webhooks. When a user comments a designated trigger keyword (e.g., 'WORKFLOW' or 'SCALE') on your Reel or post, our background workers immediately dispatch a private direct message containing your resource link and log the prospect into 180 CRM."
  },
  {
    question: "Which social media networks can I publish to directly?",
    answer: "180 Social Studio supports native multi-channel scheduling and direct API publishing to YouTube (Shorts & long-form), Instagram (Reels & Feed), Twitter/X, LinkedIn (Profiles & Company Pages), and Facebook Pages."
  },
  {
    question: "Can agencies invite clients to review and approve posts?",
    answer: "Yes. Social Studio provides secure, branded client approval portals. External clients can review pixel-perfect post previews, leave timestamped feedback, and approve drafts with a single click without requiring full workspace access."
  }
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/apps' },
  { name: '180 Social Studio', url: '/180-social-studio' }
];
---

<Layout 
  title="180 Social Studio — Autonomous AI Video Editor, Mobile Teleprompter & Omnichannel Publisher"
  description="All-in-one creator engine: >500 FPS lossless video editor, voice-paced mobile teleprompter, Auto-DM comment automation, and multi-network social scheduling."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  applicationCategory="MultimediaApplication"
>
  <main class="w-full relative">
    
    <AppHero 
      title="Autonomous AI Video Studio, Mobile Teleprompter &"
      highlightText="Omnichannel Publisher."
      description="Record with smart voice-paced teleprompter, edit at >500 FPS with lossless stream-copy rendering, and convert viral comments into CRM leads with Auto-DM automation."
      breadcrumbs={breadcrumbs}
    />

    <CapabilityPillars 
      sectionBadge="Social Studio Features"
      sectionTitle="Everything your creative team needs to scale content output."
      sectionSubtitle="From raw footage cuts to scheduled multi-network distribution in one cohesive workflow."
      pillars={pillars}
    />

    <VideoPlaybook 
      sectionBadge="Creative Playbook"
      title="From Raw Footage to Viral Social Post"
      subtitle="Follow these 4 steps to produce and schedule high-impact content across every channel."
      videoCaption="2-Minute 180 Social Studio Walkthrough"
      steps={playbookSteps}
    />

    <WorkGraphSynergy 
      currentAppName="180 Social Studio"
      title="Creative publishing connected to business growth."
      subtitle="See how social impressions and video engagements flow into CRM leads and revenue attribution."
      synergies={synergies}
    />

    <FAQAccordion 
      sectionBadge="Social Studio FAQs"
      title="Frequently Asked Questions about 180 Social Studio"
      subtitle="Answers regarding video engine performance, platform connections, approval tiers, and client access."
      faqs={faqs}
    />

    <AppBottomCTA 
      appName="180 Social Studio" 
      headline="Scale your content production without the subscription bloat."
      subheadline="Start editing faster and scheduling smarter today with 180 Social Studio on 180workspace."
    />

    <ProductEcosystemBacklinks currentProduct="social-studio" />

  </main>
</Layout>

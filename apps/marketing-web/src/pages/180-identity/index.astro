---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ProductEcosystemBacklinks from '../../components/seo/ProductEcosystemBacklinks.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ecosystem', url: '/apps' },
  { name: '180 Identity', url: '/180-identity' }
];

const pillars = [
  {
    badge: "99.2% in 2 Seconds",
    title: "Universal WhatsApp OTP Authentication",
    description: "Standard SMS OTPs fail up to 28% of the time due to telecom routing delays and spam filtering, costing businesses tens of thousands in abandoned signups. 180 Identity delivers 99.2% OTPs in under 2 seconds directly over WhatsApp Business API.",
    bullets: [
      "99.2% OTP delivery success within 2000 milliseconds",
      "Official verified green checkmark business trust badge",
      "Eliminates per-SMS carrier surcharges and international route drops"
    ]
  },
  {
    badge: "FIDO2 / WebAuthn",
    title: "Biometric Passwordless Passkeys",
    description: "Allow users to authenticate instantly using Touch ID, Face ID, Windows Hello, or hardware security keys (YubiKey). Eliminate password fatigue, credential stuffing attacks, and forgotten password reset emails.",
    bullets: [
      "Phishing-resistant cryptographic public key authentication",
      "Instant 1-tap sign-in on iOS, Android, macOS, and Windows",
      "Automatic fallback to WhatsApp OTP on unconfigured devices"
    ]
  },
  {
    badge: "<45ms In-DOM Modal",
    title: "Adaptive Mobile Bottom Sheet Client SDK",
    description: "Keep visitors inside your product experience. Our 12KB lightweight SDK (@workspace/identity-sdk) renders an adaptive bottom sheet on mobile screens and a frosted glass modal on desktop with zero jarring redirects or popup blocker rejections.",
    bullets: [
      "Zero external full-page redirects or clunky popups",
      "Slide-up touch sheet with swipe-down dismissal",
      "First-class SDK bindings for React, Next.js, Vue, Node.js & Flutter"
    ]
  },
  {
    badge: "RFC 8252 Loopback",
    title: "Dynamic Localhost Port Matching",
    description: "Never debug 'redirect_uri mismatch' errors again. In accordance with RFC 8252, 180 Identity automatically matches any dynamic port on localhost, 127.0.0.1, 10.0.2.2 (Android), or ::1 during local development without manual console whitelisting.",
    bullets: [
      "Auto-accepts localhost:3000, 3005, 5173, 8080 and dynamic dev ports",
      "Seamless Android emulator (10.0.2.2) and iOS simulator loopbacks",
      "100% compliant with OAuth 2.0 Native Apps specification (RFC 8252)"
    ]
  },
  {
    badge: "OIDC Normalization",
    title: "Universal OIDC Claims & Zero DB Crashes",
    description: "Calling /userinfo returns normalized standard claims (sub, name, preferred_username, email, phone_number, picture) alongside legacy aliases. Your Prisma, Drizzle, or TypeORM database models never crash from inconsistent keys.",
    bullets: [
      "OpenID Connect Core 1.0 standard claim schema",
      "Both standard keys and legacy aliases provided simultaneously",
      "Turnkey 1-line server exchange: const { user } = await exchangeAuthCode(code)"
    ]
  },
  {
    badge: "Sub-Millisecond Verification",
    title: "Local RS256 JWKS Cryptographic Verification",
    description: "Your API backends verify access tokens locally using public cryptographic keys cached from /certs/jwks.json. Zero external HTTP roundtrips per user request, guaranteeing sub-millisecond API execution and zero vendor downtime risk.",
    bullets: [
      "Local RS256 asymmetric signature verification in <1ms",
      "Standard JWT payload compatible with any backend language",
      "Rotatable key pairs with zero application downtime"
    ]
  }
];

const comparisonData = [
  { feature: "WhatsApp One-Tap OTP", oneEighty: "Native (99.2% in 2s)", auth0: "Custom Twilio Addon", clerk: "Limited / Beta", firebase: "SMS Only" },
  { feature: "Localhost Port Flexibility", oneEighty: "RFC 8252 (Dynamic Any Port)", auth0: "Strict URL Whitelist", clerk: "Strict URL Whitelist", firebase: "Strict URL Whitelist" },
  { feature: "Per-SMS Telecom Surcharges", oneEighty: "$0.00 (Flat WhatsApp)", auth0: "$0.05-$0.08 per SMS", clerk: "$0.05-$0.08 per SMS", firebase: "High Carrier Fees" },
  { feature: "Mobile Checkout / Login UX", oneEighty: "<45ms Bottom Sheet", auth0: "Hosted Page Redirect", clerk: "Iframe Modal", firebase: "FirebaseUI Iframe" },
  { feature: "Biometric Passkeys (WebAuthn)", oneEighty: "Included Native", auth0: "Enterprise Tier ($$$)", clerk: "Included", firebase: "Custom Code" },
  { feature: "Backend JWKS Verification", oneEighty: "<1ms Local RS256", auth0: "Rate-Limited JWKS", clerk: "Remote Middleware", firebase: "Google Admin SDK" },
  { feature: "Integration Lines of Code", oneEighty: "3-5 Clean Lines", auth0: "60-100 Lines", clerk: "30-50 Lines", firebase: "40-80 Lines" }
];

const faqs = [
  {
    question: "What is 180 Identity?",
    answer: "180 Identity is an enterprise authentication and user identity platform featuring universal WhatsApp OTP delivery, biometric WebAuthn passkeys, RFC 7636 OAuth 2.0 PKCE, RFC 8252 dynamic loopback ports, and a native in-DOM adaptive bottom-sheet modal SDK designed to eliminate SMS delivery failures and user abandonment."
  },
  {
    question: "Why is WhatsApp OTP superior to standard carrier SMS OTP?",
    answer: "Carrier SMS messages suffer an average failure rate of 15% to 28% due to international telecom routing hops, carrier spam filters, and network congestion. In contrast, WhatsApp OTP achieves a 99.2% delivery success rate within 2 seconds with official verified business branding and zero carrier markups."
  },
  {
    question: "How does RFC 8252 dynamic loopback port matching work for developers?",
    answer: "When building applications locally, your development server may dynamically switch from port 3000 to 3005 or 5173. Standard OAuth servers reject these redirects with strict URI errors. 180 Identity complies with RFC 8252 section 7.3, allowing any port on loopback interfaces (localhost, 127.0.0.1, 10.0.2.2) to authenticate seamlessly without manual whitelisting."
  },
  {
    question: "How does the in-DOM bottom-sheet login modal work?",
    answer: "Instead of redirecting users away to an external hosted login page (like Auth0 or Okta), the 180 Identity client SDK mounts an adaptive bottom sheet on mobile screens and a glass modal on desktop. Users sign in and return to their flow in seconds with zero page reloads and zero browser popup blocker interference."
  },
  {
    question: "Do I need to build any custom login or registration screens?",
    answer: "No. Developers never need to build login screens, registration forms, WhatsApp OTP popups, biometric enrollment modals, 2FA prompts, password reset flows, or OAuth consent dialogs. 180 Identity provides 100% pre-built, hosted flows via in-DOM bottom sheets, drop-in web components (<one-eighty-auth-button>), or Flutter/React Native In-App WebViews with OneEightyMobileChannel."
  },
  {
    question: "How does backend token verification work with 180 Identity?",
    answer: "Your backend downloads and caches 180 Identity's public cryptographic keys from https://api.180core.cloud/certs/jwks.json. Using standard RS256 JWT libraries, your API verifies signatures locally in less than 1 millisecond without making an outbound network request on every request."
  }
];
---

<Layout
  title="180 Identity — WhatsApp OTP Authentication & Biometric Passkey SSO | 180workspace"
  description="Deliver 99.2% login deliverability in under 2s with WhatsApp OTP, biometric WebAuthn passkeys, RFC 8252 dynamic loopback ports, and in-DOM bottom sheet modal SDK."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  applicationCategory="SecurityApplication"
>
  <div class="relative min-h-screen bg-slate-50 dark:bg-black text-slate-900 dark:text-zinc-100 overflow-hidden selection:bg-indigo-500 selection:text-white">
    {/* Background Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[550px] bg-gradient-to-b from-teal-500/10 via-emerald-500/5 to-transparent dark:from-teal-600/15 dark:via-emerald-600/10 blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-60 left-1/4 w-96 h-96 bg-blue-500/10 dark:bg-blue-600/10 blur-[128px] pointer-events-none -z-10"></div>
    <div class="absolute inset-0 bg-grid-pattern dark:bg-grid-pattern-dark opacity-20 dark:opacity-10 pointer-events-none -z-10"></div>

    {/* Breadcrumbs */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <Breadcrumb items={breadcrumbs} />
    </div>

    {/* Hero Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-16 lg:pt-20 pb-16 text-center space-y-8">
      {/* Eyebrow Pill */}
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/90 dark:bg-zinc-900/90 border border-slate-200 dark:border-white/10 text-xs text-slate-700 dark:text-zinc-300 backdrop-blur-xl shadow-xs transition-all hover:border-slate-300 dark:hover:border-white/20">
        <span class="w-2 h-2 rounded-full bg-teal-500 dark:bg-teal-400 animate-pulse"></span>
        <span class="font-medium">Sovereign Identity Infrastructure</span>
        <span class="text-slate-300 dark:text-zinc-600">/</span>
        <span class="text-teal-600 dark:text-teal-400 font-mono text-[11px] font-semibold">99.2% Delivery in &lt;2s • RFC 8252 Dynamic Ports</span>
      </div>

      {/* Main Headline */}
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-slate-950 dark:text-white leading-[1.08] max-w-5xl mx-auto">
        Authentication That Converts. <br class="hidden sm:block" />
        <span class="bg-gradient-to-r from-teal-600 via-emerald-600 to-indigo-600 dark:from-teal-400 dark:via-emerald-300 dark:to-indigo-400 bg-clip-text text-transparent">
          WhatsApp OTP & Biometric Passkeys.
        </span>
      </h1>

      {/* AEO BLUF Lead Description */}
      <p class="max-w-3xl mx-auto text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal aeo-answer">
        180 Identity delivers 99.2% login deliverability in under 2 seconds via verified WhatsApp Business OTP, biometric WebAuthn passkeys, RFC 7636 OAuth 2.0 PKCE, RFC 8252 dynamic loopback ports, and an adaptive in-DOM bottom-sheet authentication modal with zero per-SMS carrier surcharges.
      </p>

      {/* Hero Action CTAs */}
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 pt-2 max-w-md sm:max-w-none mx-auto">
        <button
          type="button"
          data-180-identity-login
          data-client-id="180-identity-hero"
          data-redirect-url="https://app.180workspace.com"
          class="min-h-[48px] px-8 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 dark:bg-white text-white dark:text-black dark:hover:bg-zinc-100 font-bold text-sm shadow-xl hover:shadow-teal-500/10 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Try Interactive Login Modal</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>

        <a
          href="https://docs.180workspace.com/docs/products/180-core/180-identity/getting-started"
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[48px] px-7 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-zinc-200 hover:text-slate-950 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-zinc-800 font-semibold text-sm transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 shadow-xs"
        >
          <svg class="w-4 h-4 text-slate-400 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Read SDK & API Docs</span>
        </a>
      </div>

      {/* Metrics Bar */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8">
        <div class="p-4 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-white/10 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-teal-600 dark:text-teal-400">99.2%</div>
          <div class="text-xs text-slate-500 dark:text-zinc-400 font-medium mt-1">Delivery Success Rate</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-white/10 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">&lt;2s</div>
          <div class="text-xs text-slate-500 dark:text-zinc-400 font-medium mt-1">WhatsApp Delivery Speed</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-white/10 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">&lt;1ms</div>
          <div class="text-xs text-slate-500 dark:text-zinc-400 font-medium mt-1">Local RS256 Verification</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/70 dark:bg-zinc-900/60 border border-slate-200/80 dark:border-white/10 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-indigo-600 dark:text-indigo-400">3 Lines</div>
          <div class="text-xs text-slate-500 dark:text-zinc-400 font-medium mt-1">Full SDK Integration</div>
        </div>
      </div>
    </section>

    {/* Integration Code Playground Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">Takes 60 Seconds</span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-950 dark:text-white mt-2">
          From Install to Verified User in 4 Lines
        </h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-zinc-400">
          Mount a zero-popup-blocker bottom sheet in the frontend, and exchange the code on your backend in a single line.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Frontend Code Card */}
        <div class="rounded-3xl border border-slate-800 bg-slate-950 p-6 overflow-hidden shadow-2xl">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-teal-500"></span>
              <span class="text-xs font-mono font-bold text-slate-300">Frontend: React / Vanilla / Vue</span>
            </div>
            <span class="text-[10px] font-mono font-bold bg-teal-950 text-teal-300 px-2 py-0.5 rounded border border-teal-800">@workspace/identity-sdk</span>
          </div>
          <pre class="mt-4 text-xs font-mono text-slate-300 leading-relaxed overflow-x-auto"><code><span class="text-purple-400">import</span> {'{'} <span class="text-sky-300">OneEightyIdentity</span> {'}'} <span class="text-purple-400">from</span> <span class="text-emerald-400">'@workspace/identity-sdk'</span>;

<span class="text-slate-500">// 1. Opens non-blocking in-DOM slide-up sheet (No popup blockers!)</span>
<span class="text-sky-300">OneEightyIdentity</span>.<span class="text-sky-300">openBottomSheet</span>({'{'}
  <span class="text-slate-400">clientId:</span> <span class="text-emerald-400">'YOUR_CLIENT_ID'</span>,
  <span class="text-sky-300">onSuccess:</span> <span class="text-purple-400">async</span> ({'{'} <span class="text-slate-300">code</span> {'}'}) =&gt; {'{'}
    <span class="text-purple-400">await</span> <span class="text-sky-300">fetch</span>(<span class="text-emerald-400">'/api/auth/exchange'</span>, {'{'}
      <span class="text-slate-400">method:</span> <span class="text-emerald-400">'POST'</span>,
      <span class="text-slate-400">body:</span> JSON.<span class="text-sky-300">stringify</span>({'{'} code {'}'})
    {'}'});
    window.location.href = <span class="text-emerald-400">'/dashboard'</span>;
  {'}'}
{'}'});</code></pre>
        </div>

        {/* Backend Code Card */}
        <div class="rounded-3xl border border-slate-800 bg-slate-950 p-6 overflow-hidden shadow-2xl">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
              <span class="text-xs font-mono font-bold text-slate-300">Backend: 1-Line Code Exchange</span>
            </div>
            <span class="text-[10px] font-mono font-bold bg-indigo-950 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800">Node.js / Next.js / Express</span>
          </div>
          <pre class="mt-4 text-xs font-mono text-slate-300 leading-relaxed overflow-x-auto"><code><span class="text-purple-400">import</span> {'{'} <span class="text-sky-300">exchangeAuthCode</span> {'}'} <span class="text-purple-400">from</span> <span class="text-emerald-400">'@workspace/identity-sdk'</span>;

<span class="text-slate-500">// 2. Exchange code for normalized profile in 1 line:</span>
<span class="text-purple-400">const</span> {'{'} <span class="text-sky-300">user</span>, <span class="text-sky-300">tokens</span> {'}'} = <span class="text-purple-400">await</span> <span class="text-sky-300">exchangeAuthCode</span>(code);

<span class="text-slate-500">// Standard OIDC claims ready for your database:</span>
console.<span class="text-sky-300">log</span>(user.name, user.email, user.phone_number);

<span class="text-slate-500">// Or verify statelessly via RS256 JWKS:</span>
<span class="text-slate-500">// https://api.180core.cloud/certs/jwks.json</span></code></pre>
        </div>
      </div>
    </section>

    {/* The Zero Custom Screen Guarantee Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="rounded-3xl border border-teal-500/20 bg-gradient-to-br from-slate-900 via-slate-950 to-teal-950/40 p-8 sm:p-12 text-white shadow-2xl relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-3xl mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 text-xs font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
            Zero Custom Screen Mandate
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            Do You Need to Build Custom Screens? <span class="text-teal-400">NO.</span>
          </h2>
          <p class="mt-3 text-sm sm:text-base text-slate-300">
            A core invariant of 180 Identity is that developers never spend engineering hours designing, styling, or debugging authentication screens.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* What Developers Do NOT Build */}
          <div class="rounded-2xl border border-rose-500/20 bg-rose-950/10 p-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-rose-400 flex items-center gap-2 mb-4">
              <span>What You NEVER Have to Build</span>
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>Login or sign-in screens</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>User registration or sign-up forms</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>WhatsApp 1-Tap OTP or SMS verification popups</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>Biometric Passkey / WebAuthn enrollment modals</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>Forgot password or account recovery flows</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>2-Factor Authentication (2FA) verification screens</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="text-rose-400 font-bold">❌</span>
                <span>OAuth 2.0 Consent & Authorization dialogs</span>
              </li>
            </ul>
          </div>

          {/* How It Integrates */}
          <div class="rounded-2xl border border-teal-500/20 bg-teal-950/10 p-6 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-teal-400 flex items-center gap-2 mb-4">
                <span>How It Integrates (3 Pre-Built Options)</span>
              </h3>
              <div class="space-y-4 text-xs sm:text-sm text-slate-300">
                <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
                  <div class="font-bold text-white flex items-center gap-2">
                    <span class="text-teal-400 font-mono">1.</span> In-DOM Bottom Sheet / Glass Modal (Web)
                  </div>
                  <p class="text-xs text-slate-400 mt-1">
                    With 1 line (<code class="text-teal-300">OneEighty.signIn({'{'} uxMode: 'bottom_sheet' {'}'})</code>), an adaptive sheet slides up on mobile or a sleek glass modal opens on desktop. User never leaves your app.
                  </p>
                </div>
                <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
                  <div class="font-bold text-white flex items-center gap-2">
                    <span class="text-teal-400 font-mono">2.</span> Drop-in Web Component
                  </div>
                  <p class="text-xs text-slate-400 mt-1">
                    Include <code class="text-teal-300">&lt;one-eighty-auth-button&gt;</code> (HTML) or <code class="text-teal-300">&lt;OneEightyButton /&gt;</code> (React) for an immediate, branded, responsive login trigger.
                  </p>
                </div>
                <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
                  <div class="font-bold text-white flex items-center gap-2">
                    <span class="text-teal-400 font-mono">3.</span> Native Mobile (Flutter / React Native)
                  </div>
                  <p class="text-xs text-slate-400 mt-1">
                    Launch <code class="text-teal-300">profile.180core.cloud/auth/login</code> in an In-App WebView with <code class="text-teal-300">OneEightyMobileChannel</code> bridge or deep-link redirect (<code class="text-teal-300">myapp://oauth/callback</code>).
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Capability Pillars Grid */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-950 dark:text-white">
          Enterprise Security Without Developer Pain
        </h2>
        <p class="mt-4 text-base text-slate-600 dark:text-zinc-400 font-normal">
          Designed for high-trust products where login speed directly impacts activation, retention, and revenue.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pillars.map((pillar) => (
          <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900/90 border border-slate-200/80 dark:border-white/10 hover:border-teal-500/40 dark:hover:border-teal-500/40 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                {pillar.badge}
              </span>
              <h3 class="text-xl font-bold text-slate-950 dark:text-white mt-4 mb-3">
                {pillar.title}
              </h3>
              <p class="text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
                {pillar.description}
              </p>
            </div>
            <ul class="space-y-2.5 pt-4 border-t border-slate-100 dark:border-white/5">
              {pillar.bullets.map((b) => (
                <li class="flex items-start gap-2.5 text-xs text-slate-600 dark:text-zinc-300">
                  <svg class="w-4 h-4 text-teal-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {/* Comparison Matrix (AEO Citation Goldmine) */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-950 dark:text-white">
          180 Identity vs Legacy Auth Providers
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-zinc-400">
          Compare 180 Identity against Auth0, Clerk, and Firebase Auth on delivery speed, UX, and total cost of ownership.
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-slate-200 dark:border-white/10 bg-white dark:bg-zinc-900 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-zinc-950/60">
              <th class="p-4 sm:p-5 font-bold text-slate-900 dark:text-white">Feature</th>
              <th class="p-4 sm:p-5 font-bold text-teal-600 dark:text-teal-400 bg-teal-500/5">180 Identity</th>
              <th class="p-4 sm:p-5 font-semibold text-slate-600 dark:text-zinc-400">Auth0</th>
              <th class="p-4 sm:p-5 font-semibold text-slate-600 dark:text-zinc-400">Clerk</th>
              <th class="p-4 sm:p-5 font-semibold text-slate-600 dark:text-zinc-400">Firebase Auth</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-white/5">
            {comparisonData.map((row) => (
              <tr class="hover:bg-slate-50/50 dark:hover:bg-white/5 transition-colors">
                <td class="p-4 sm:p-5 font-semibold text-slate-900 dark:text-white">{row.feature}</td>
                <td class="p-4 sm:p-5 font-bold text-teal-600 dark:text-teal-400 bg-teal-500/5">{row.oneEighty}</td>
                <td class="p-4 sm:p-5 text-slate-600 dark:text-zinc-400">{row.auth0}</td>
                <td class="p-4 sm:p-5 text-slate-600 dark:text-zinc-400">{row.clerk}</td>
                <td class="p-4 sm:p-5 text-slate-600 dark:text-zinc-400">{row.firebase}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Frequently Asked Questions (AEO & Schema) */}
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">Direct Answers</span>
        <h2 class="text-3xl font-black text-slate-950 dark:text-white mt-2">
          Frequently Asked Questions About 180 Identity
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-white/10 transition-all hover:border-teal-500/40 cursor-pointer">
            <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-slate-950 dark:text-white list-none">
              <span>{faq.question}</span>
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-4 text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal aeo-summary">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

    {/* Cross-Product Ecosystem Backlink Hub */}
    <ProductEcosystemBacklinks currentProduct="identity" />
  </div>
</Layout>

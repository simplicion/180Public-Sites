---
// Define the SaaS base URL
const saasUrl = import.meta.env.PUBLIC_SAAS_URL || 'https://app.180workspace.com';

const appCategories = [
  {
    category: "Revenue & Growth",
    apps: [
      { name: "Voiceforce (AI Calling)", slug: "voiceforce", desc: "Autonomous AI phone agents & global calls", badge: "AI" },
      { name: "CRM & Sales", slug: "crm-and-sales", desc: "Lead pipelines, deal stages & contracts", badge: "Popular" },
      { name: "Advertising", slug: "advertising", desc: "Multi-platform ad spend vs closed revenue", badge: "" },
    ]
  },
  {
    category: "Operations & People",
    apps: [
      { name: "Projects & Tasks", slug: "projects-and-tasks", desc: "Kanban boards, sprints & timelogs", badge: "" },
      { name: "HR & Payroll", slug: "hr-management", desc: "Employee directory, leaves & salaries", badge: "" },
      { name: "Finance & Analytics", slug: "finance", desc: "Cash flow, invoices & financial ledger", badge: "Core" },
    ]
  },
  {
    category: "Tools & Collaboration",
    apps: [
      { name: "Communications", slug: "communications", desc: "Team chat & 180 HD video meetings", badge: "" },
      { name: "Workspace Tools", slug: "workspace-tools", desc: "180 Docs, shared calendar & cloud storage", badge: "" },
    ]
  }
];

const ecosystemProducts = [
  {
    title: "180 Workspace",
    href: saasUrl,
    badge: "Core OS",
    badgeColor: "bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800",
    desc: "The all-in-one business operating system with 8 connected apps on one Work Graph.",
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>',
    isExternal: false,
    tag: "app.180workspace.com"
  },
  {
    title: "180 Core",
    href: "/180-core",
    badge: "Sovereign API",
    badgeColor: "bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border-blue-200 dark:border-blue-800",
    desc: "Sovereign Identity SSO (WhatsApp OTP, OAuth 2.0 PKCE), Universal Profile & 180 Pay APIs.",
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>',
    isExternal: false,
    tag: "developer.180core.cloud"
  },
  {
    title: "180 Traffic Director",
    href: "/180-traffic-director",
    badge: "Edge Routing",
    badgeColor: "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800",
    desc: "Sub-5ms Cloudflare edge routing, bot mitigation, dynamic ad cloaking & traffic filtering.",
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
    isExternal: false,
    tag: "traffic.180workspace.com"
  },
  {
    title: "180 Social Studio",
    href: "/180-social-studio",
    badge: "Creative AI",
    badgeColor: "bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300 border-purple-200 dark:border-purple-800",
    desc: "Autonomous video editor engine (Remotion) & multi-channel social media publisher.",
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>',
    isExternal: false,
    tag: "social.180workspace.com"
  }
];

const resources = [
  {
    title: "Docs Portal",
    href: "https://docs.180workspace.com",
    desc: "Enterprise architecture blueprints, runbooks, and multi-tenant schema guides",
    badge: "Docs",
    isExternal: true
  },
  {
    title: "Blog & Product News",
    href: "/blog",
    desc: "Latest release notes, engineering insights, and playbooks",
    badge: "Articles"
  },
  {
    title: "White Papers & Research",
    href: "/whitepapers",
    desc: "Work Graph Architecture, edge routing & sovereign ledger whitepapers",
    badge: "Research"
  },
  {
    title: "Case Studies",
    href: "/case-studies",
    desc: "Real-world customer success and Work Graph ROI stories",
    badge: "Results"
  }
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 dark:border-white/10 bg-white/85 dark:bg-black/85 backdrop-blur-xl supports-[backdrop-filter]:bg-white/70 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.03)] transition-all">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl flex h-16 items-center justify-between gap-4">
    
    {/* Brand Logo */}
    <div class="flex items-center gap-6 xl:gap-8 shrink-0">
      <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="180workspace Home">
        <img src="/icons/black-icon.svg" alt="180workspace" class="w-8 h-8 sm:w-9 sm:h-9 group-hover:scale-105 transition-transform dark:hidden" width="36" height="36" />
        <img src="/icons/white-icon.svg" alt="180workspace" class="w-8 h-8 sm:w-9 sm:h-9 group-hover:scale-105 transition-transform hidden dark:block" width="36" height="36" />
        <span class="text-lg sm:text-xl font-black tracking-tight text-slate-950 dark:text-white whitespace-nowrap">
          180<span class="text-indigo-600 dark:text-indigo-400">workspace</span>
        </span>
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5" aria-label="Main Navigation">
        
        {/* 1. Apps Mega-Menu Trigger (8 Workspace Apps) */}
        <div class="relative group">
          <button 
            type="button" 
            aria-expanded="false" 
            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap cursor-pointer"
          >
            <span>Apps</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          {/* Mega-Menu Dropdown Panel */}
          <div class="absolute left-0 top-full pt-2 w-[840px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white/95 dark:bg-zinc-900/95 rounded-2xl p-6 border border-slate-200 dark:border-white/10 shadow-2xl shadow-black/20 backdrop-blur-2xl">
              <div class="grid grid-cols-3 gap-6">
                {appCategories.map((col) => (
                  <div>
                    <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500 mb-3 px-2">
                      {col.category}
                    </h4>
                    <div class="space-y-1">
                      {col.apps.map((app) => (
                        <a 
                          href={`/apps/${app.slug}`} 
                          class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-indigo-50/50 dark:hover:bg-zinc-800/80 transition-colors group/item"
                        >
                          <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-900/50 flex items-center justify-center shrink-0 mt-0.5 text-indigo-600 dark:text-indigo-400 group-hover/item:bg-indigo-600 group-hover/item:text-white transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                          </div>
                          <div class="min-w-0">
                            <div class="flex items-center gap-1.5">
                              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover/item:text-indigo-600 transition-colors truncate">
                                {app.name}
                              </span>
                              {app.badge && (
                                <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 shrink-0">
                                  {app.badge}
                                </span>
                              )}
                            </div>
                            <p class="text-[11px] text-slate-500 dark:text-zinc-400 line-clamp-1">
                              {app.desc}
                            </p>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              {/* Mega-Menu Bottom Bar */}
              <div class="mt-4 pt-4 border-t border-slate-100 dark:border-white/10 flex items-center justify-between px-2 text-xs">
                <span class="text-slate-500 dark:text-zinc-400 font-medium">All 8 applications operate on one unified Work Graph database</span>
                <a href="/apps" class="font-bold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 flex items-center gap-1 transition-colors">
                  <span>Explore All 8 Apps Directory</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* 2. Products Dropdown Trigger (Ecosystem Flagships) */}
        <div class="relative group">
          <button 
            type="button" 
            aria-expanded="false" 
            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap cursor-pointer"
          >
            <span>Products</span>
            <span class="text-[9px] font-black uppercase px-1.5 py-0.2 rounded-full bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60">
              Ecosystem
            </span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          {/* Products Mega-Dropdown Panel */}
          <div class="absolute left-0 top-full pt-2 w-[540px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white/95 dark:bg-zinc-900/95 rounded-2xl p-5 border border-slate-200 dark:border-white/10 shadow-2xl shadow-black/20 backdrop-blur-2xl">
              <div class="mb-3 px-2 flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500">
                  180 Sovereign Platforms
                </span>
                <span class="text-[10px] text-slate-400 dark:text-zinc-500 font-mono">
                  Autonomous Web & Cloud
                </span>
              </div>

              <div class="grid grid-cols-1 gap-1.5">
                {ecosystemProducts.map((prod) => (
                  <a
                    href={prod.href}
                    target={prod.isExternal ? "_blank" : undefined}
                    rel={prod.isExternal ? "noopener noreferrer" : undefined}
                    class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-zinc-800/80 transition-all group/prod border border-transparent hover:border-slate-200/60 dark:hover:border-zinc-700/60"
                  >
                    <div class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 flex items-center justify-center shrink-0 mt-0.5 text-slate-700 dark:text-zinc-300 group-hover/prod:bg-indigo-600 group-hover/prod:text-white transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={prod.iconSvg}></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-bold text-slate-900 dark:text-white group-hover/prod:text-indigo-600 dark:group-hover/prod:text-indigo-400 transition-colors">
                          {prod.title}
                        </span>
                        <span class={`text-[9px] font-black uppercase px-2 py-0.5 rounded-full border ${prod.badgeColor} shrink-0`}>
                          {prod.badge}
                        </span>
                      </div>
                      <p class="text-[11px] text-slate-500 dark:text-zinc-400 mt-0.5 line-clamp-1">
                        {prod.desc}
                      </p>
                    </div>
                  </a>
                ))}
              </div>

              {/* Bottom Developer Banner */}
              <div class="mt-3 pt-3 border-t border-slate-100 dark:border-white/10 flex items-center justify-between px-2 text-xs">
                <span class="text-slate-500 dark:text-zinc-400 font-medium">Looking for APIs & SDKs?</span>
                <a 
                  href="https://developer.180core.cloud" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="font-bold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 flex items-center gap-1 transition-colors"
                >
                  <span>Visit Developer Console</span>
                  <span>↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* 3. Pricing */}
        <a href="/pricing" class="px-3 py-2 text-sm font-semibold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap">
          Pricing
        </a>


        {/* 5. Free Tools */}
        <a href="/tools" class="px-3 py-2 text-sm font-semibold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap">
          Free Tools
        </a>

        {/* 6. Resources Dropdown */}
        <div class="relative group">
          <button 
            type="button" 
            aria-expanded="false" 
            class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap cursor-pointer"
          >
            <span>Resources</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-indigo-600 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          {/* Resources Dropdown Menu */}
          <div class="absolute left-0 top-full pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white/95 dark:bg-zinc-900/95 rounded-2xl p-3 border border-slate-200 dark:border-white/10 shadow-xl shadow-black/20 backdrop-blur-xl space-y-1">
              {resources.map((res) => (
                <a 
                  href={res.href} 
                  target={res.isExternal ? "_blank" : undefined}
                  rel={res.isExternal ? "noopener noreferrer" : undefined}
                  class="block p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-zinc-800/80 transition-colors group/res"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-white group-hover/res:text-indigo-600 dark:group-hover/res:text-indigo-400 transition-colors">
                      {res.title}
                    </span>
                    {res.badge && (
                      <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-slate-100 dark:bg-zinc-800 text-slate-600 dark:text-zinc-300">
                        {res.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-[11px] text-slate-500 dark:text-zinc-400 mt-0.5 line-clamp-1">
                    {res.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

      </nav>
    </div>

    {/* Auth & CTA Area + Mobile Toggle */}
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      <a 
        href={`${saasUrl}/login`} 
        data-180-identity-login
        data-redirect-url={`${saasUrl}`}
        class="hidden md:inline-flex text-sm font-bold text-slate-700 dark:text-zinc-200 hover:text-indigo-600 dark:hover:text-indigo-400 px-3 py-2 rounded-xl hover:bg-slate-100/60 dark:hover:bg-zinc-900/60 transition-colors whitespace-nowrap min-h-[44px] items-center cursor-pointer"
      >
        Sign In
      </a>
      
      <a 
        href={`${saasUrl}/signup?plan=kickstart`} 
        class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-5 md:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20 hover:shadow-indigo-600/35 hover:scale-[1.02] active:scale-[0.98] transition-all whitespace-nowrap shrink-0 group cursor-pointer min-h-[38px] sm:min-h-[44px]"
      >
        <span class="hidden sm:inline">Start with $10 Plan</span>
        <span class="sm:hidden">Start Plan</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>

      {/* Mobile Menu Hamburger Button */}
      <button 
        type="button"
        id="mobile-menu-btn"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        class="lg:hidden p-2 min-h-[40px] min-w-[40px] sm:min-h-[44px] sm:min-w-[44px] rounded-xl text-slate-700 dark:text-zinc-200 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer shrink-0"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

  </div>

  {/* Mobile Navigation Drawer */}
  <div 
    id="mobile-drawer" 
    class="lg:hidden hidden fixed inset-x-0 top-16 bottom-0 z-50 max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-slate-200 dark:border-white/10 bg-white/95 dark:bg-black/95 backdrop-blur-2xl px-4 py-6 space-y-6 shadow-2xl"
  >
    {/* Top Action CTAs in Mobile Menu */}
    <div class="grid grid-cols-2 gap-2 pb-5 border-b border-slate-200/80 dark:border-white/10">
      <a 
        href={`${saasUrl}/login`} 
        data-180-identity-login
        data-redirect-url={`${saasUrl}`}
        class="btn-secondary w-full text-center py-2.5 text-xs font-bold min-h-[44px] flex items-center justify-center cursor-pointer"
      >
        Sign In
      </a>
      <a 
        href={`${saasUrl}/signup?plan=kickstart`} 
        class="btn-primary w-full text-center py-2.5 text-xs font-bold flex items-center justify-center gap-1.5 min-h-[44px]"
      >
        <span>$10 Plan</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
    </div>

    {/* Section 1: Flagship Sovereign Platforms */}
    <div class="space-y-2">
      <div class="flex items-center justify-between px-1">
        <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 dark:text-zinc-500">
          Sovereign Platforms
        </span>
        <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-mono font-bold">
          Ecosystem
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {ecosystemProducts.map((prod) => (
          <a
            href={prod.href}
            target={prod.isExternal ? "_blank" : undefined}
            rel={prod.isExternal ? "noopener noreferrer" : undefined}
            class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50/80 dark:bg-zinc-900/70 border border-slate-200/60 dark:border-white/5 hover:border-indigo-300 dark:hover:border-indigo-500/40 transition-all min-h-[52px]"
          >
            <div class="w-8 h-8 rounded-xl bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 flex items-center justify-center shrink-0 mt-0.5 text-slate-700 dark:text-zinc-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={prod.iconSvg}></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1.5">
                <span class="text-xs font-bold text-slate-900 dark:text-white truncate">
                  {prod.title}
                </span>
                <span class={`text-[8px] font-black uppercase px-1.5 py-0.2 rounded-full border ${prod.badgeColor} shrink-0`}>
                  {prod.badge}
                </span>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-zinc-400 line-clamp-1 mt-0.5">
                {prod.desc}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Section 2: 8 Connected Applications */}
    <div class="space-y-2 pt-2">
      <div class="flex items-center justify-between px-1">
        <span class="text-[11px] font-black uppercase tracking-wider text-slate-400 dark:text-zinc-500">
          8 Workspace Apps
        </span>
        <a href="/apps" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 hover:underline">
          View All →
        </a>
      </div>
      <div class="grid grid-cols-2 gap-2">

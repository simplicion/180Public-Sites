{
    "name":  "180-public-sites",
    "version":  "1.0.0",
    "private":  true,
    "description":  "180 Public Facing Web Presences: Marketing Portal & Product Documentation Suite",
    "scripts":  {
                    "dev":  "node scripts/dev-runner.js",
                    "dev:all":  "node scripts/dev-runner.js all",
                    "dev:marketing":  "pnpm --filter apps-marketing-web dev",
                    "dev:docs":  "pnpm --filter apps-docs dev",
                    "build":  "turbo run build",
                    "lint":  "turbo run lint",
                    "clean":  "turbo run clean && rm -rf node_modules",
                    "format":  "prettier --write \"**/*.{ts,tsx,astro,md}\"",
                    "deploy:marketing":  "wrangler pages deploy apps/marketing-web/dist --project-name=180workspace-marketing",
                    "deploy:docs":  "wrangler pages deploy apps/docs/build --project-name=180workspace-docs",
                    "deploy":  "turbo run build && pnpm deploy:marketing && pnpm deploy:docs"
                },
    "devDependencies":  {
                            "cross-env":  "^7.0.3",
                            "prettier":  "latest",
                            "turbo":  "latest",
                            "typescript":  "^5.9.3",
                            "wrangler":  "^4.149.0"
                        },
    "packageManager":  "pnpm@9.0.0",
    "engines":  {
                    "node":  ">=20.0.0",
                    "pnpm":  "9"
                }
}
---
import Layout from '../../layouts/Layout.astro';
import AppHero from '../../components/apps/AppHero.astro';
import CapabilityPillars from '../../components/apps/CapabilityPillars.astro';
import VideoPlaybook from '../../components/apps/VideoPlaybook.astro';
import WorkGraphSynergy from '../../components/apps/WorkGraphSynergy.astro';
import FAQAccordion from '../../components/apps/FAQAccordion.astro';
import AppBottomCTA from '../../components/apps/AppBottomCTA.astro';
import ProductEcosystemBacklinks from '../../components/seo/ProductEcosystemBacklinks.astro';

const pillars = [
  {
    badge: "Sub-5ms Latency",
    title: "Zero-Overhead Edge Traffic Evaluation",
    description: "Evaluate incoming clicks in under 5 milliseconds directly at Cloudflare Edge network before routing visitors to destination offers or safe pages.",
    bullets: [
      "Real-time IP, user-agent, and header fingerprinting",
      "Dynamic rule engine (Geo-location, device, ISP, ASN, referrer)",
      "Zero redirect lag preserving maximum ad quality scores"
    ]
  },
  {
    badge: "Simulator Tool",
    title: "Interactive Traffic Routing Simulator",
    description: "Test and verify complex routing rules, geo-filters, and bot heuristics before spending a single dollar of live advertising budget.",
    bullets: [
      "Pre-flight simulator (/traffic-director/simulator) for custom IP/UA tests",
      "Live inspection of decision traces: ALLOW, BLOCK, or SAFE_PAGE",
      "Simulate crawler bots, residential proxies, and mobile carriers"
    ]
  },
  {
    badge: "Anti-Fraud & Cloaking",
    title: "Bot Shielding & Review Crawler Cloaking",
    description: "Protect your ad spend from click fraud, competitor spy scrapers, and ad platform review bots. Serve clean compliance pages to crawlers and high-converting pages to real buyers.",
    bullets: [
      "Automated detection of Meta, Google, TikTok, and ByteDance reviewers",
      "Dedicated Threat Intelligence telemetry (/traffic-director/threats)",
      "Shield ad accounts from automated false-positive policy suspensions"
    ]
  },
  {
    badge: "Universal 1-Line Tag",
    title: "Dynamic Client Tag Injection & Verification",
    description: "Install one lightweight JS tag on external WordPress, Shopify, or Webflow landing pages to enable dynamic cloaking, headless lead capture, and visitor tracking.",
    bullets: [
      "One-line script tag (/tag/:slug) for external CMS sites",
      "Automated tag installation verifier in the dashboard",
      "Zero dependency on WordPress plugins, backend code, or DNS migration"
    ]
  },
  {
    badge: "Reverse Proxy",
    title: "Seamless Clean Page Proxy Streaming",
    description: "Stream safe destination content directly through the edge proxy (/r/_proxy/stream) without domain redirects, preserving complete URL integrity for ad platforms.",
    bullets: [
      "In-memory stream proxying with real-time HTML rewriting",
      "Preserves original display URL for Facebook & Google Ads compliance",
      "Custom HTTP header overrides & automated SSL masking"
    ]
  },
  {
    badge: "Attribution & Work Graph",
    title: "Full-Funnel Click & Revenue Attribution",
    description: "Track every ad click from initial impression to closed CRM deal revenue. Pass attribution parameters directly into 180 CRM Deals and calculate true campaign ROAS.",
    bullets: [
      "UTM, Click ID (fbclid, gclid, ttclid) auto-capture & pass-through",
      "Server-side Meta Conversions API (CAPI) & Google Offline sync",
      "Direct connection to 180 CRM Contacts, Deals, and Invoices"
    ]
  }
];

const playbookSteps = [
  {
    stepNumber: "01",
    title: "Create Campaign & Set Destinations",
    description: "Define your Campaign Slug, Safe Compliance Page URL (for bots, reviewers, and unapproved regions), and High-Converting Offer Page URL (for qualified real buyers).",
    actionSnippet: "Traffic Director -> Links -> Create Protected Link"
  },
  {
    stepNumber: "02",
    title: "Configure Edge Filters & Bot Shield",
    description: "Specify allowed target countries, device types (iOS, Android, Desktop), and block datacenter IPs. Enable automated Ad Review Cloaking for Meta, Google, and TikTok.",
    actionSnippet: "Rules: Block Crawlers = ON • Allow Mobile = ON • Filter Datacenter = ON"
  },
  {
    stepNumber: "03",
    title: "Pre-Flight Test in the Simulator",
    description: "Open the Traffic Routing Simulator (/traffic-director/simulator) to inject sample IP addresses, custom User-Agents, and referrers to verify decisions before launching ads.",
    actionSnippet: "Traffic Director -> Simulator -> Run Routing Evaluation"
  },
  {
    stepNumber: "04",
    title: "Deploy via 1-Line Tag or Edge Shortlink",
    description: "Paste the 1-line script tag into your WordPress, Shopify, or Webflow header, or use the high-performance sub-5ms Cloudflare edge shortlink as your ad target.",
    actionSnippet: '<script src="https://api.180workspace.com/tag/campaign-slug"></script>'
  }
];

const synergies = [
  {
    sourceApp: "180 Traffic Director",
    targetApp: "180 CRM & Sales",
    badge: "Closed-Loop Attribution",
    description: "Captured landing page clicks automatically pass UTM parameters, ad click IDs, and IP fingerprints directly into new CRM contacts and deals."
  },
  {
    sourceApp: "180 Traffic Director",
    targetApp: "Advertising Module",
    badge: "Real-Time ROAS",
    description: "Feeds verified conversion data and real customer value back into ad campaign dashboards to optimize ad bidding and calculate true profit."
  },
  {
    sourceApp: "180 Traffic Director",
    targetApp: "180 Core",
    badge: "Edge Security",
    description: "Integrates with sovereign edge tokens and unified access policies for high-throughput traffic inspection across global endpoints."
  }
];

const faqs = [
  {
    question: "What is 180 Traffic Director and how does it protect my ad spend?",
    answer: "180 Traffic Director is an enterprise-grade edge routing and click evaluation engine. When someone clicks your ad, Traffic Director analyzes their IP, user-agent, ASN, and fingerprint in under 5ms. Real customers are instantly routed to your high-converting offer, while ad review crawlers, competitor spy tools, and click fraud bots are served a clean, compliant safe page."
  },
  {
    question: "How does the Traffic Routing Simulator work?",
    answer: "The built-in Traffic Simulator (/traffic-director/simulator) lets media buyers enter any IP address, User-Agent string, country code, or referrer header and view an exact step-by-step trace of how the rule engine evaluates the request. You can confirm whether a Meta review bot, datacenter proxy, or overseas click would be allowed, blocked, or cloaked before spending any ad dollars."
  },
  {
    question: "What is the difference between the 1-Line Tag, Shortlink, and Reverse Proxy?",
    answer: "Traffic Director gives you three deployment modes: (1) Edge Shortlinks (/r/:slug) provide ultra-fast sub-5ms redirects; (2) The 1-Line Dynamic Tag (/tag/:slug) is a lightweight script you paste into existing Shopify, WordPress, or Webflow sites to swap content in-place without redirects; and (3) The Reverse Proxy (/r/_proxy/stream) streams the destination page HTML directly under the original ad URL with zero redirect, preserving exact URL compliance for strict ad networks."
  },
  {
    question: "How does Traffic Director identify Meta, Google, and TikTok review crawlers?",
    answer: "Traffic Director maintains an active database of known ad platform review subnets, residential proxy exit nodes, ASN ranges, and headless browser signatures. Review bots are dynamically identified and served the clean, compliant safe page to prevent unjustified ad account suspensions."
  },
  {
    question: "Does Traffic Director sync attribution with 180 CRM and ad networks?",
    answer: "Yes. Every click captures fbclid, gclid, ttclid, and UTM variables. When a visitor converts into a lead, the entire attribution footprint is attached to the contact record in 180 CRM, and can be postbacked via server-side Meta Conversions API (CAPI) or Google Offline Conversions."
  },
  {
    question: "Can I connect my own custom branded domains for tracking links?",
    answer: "Yes. You can connect unlimited custom domains through the custom domains manager. SSL certificates are provisioned automatically via Cloudflare with zero manual DNS configuration required after setting the initial CNAME record."
  }
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Apps', url: '/apps' },
  { name: '180 Traffic Director', url: '/180-traffic-director' }
];
---

<Layout 
  title="180 Traffic Director — Sub-5ms Edge Routing & Bot Shield | 180workspace"
  description="Sub-5ms edge traffic evaluation, bot shielding, dynamic tag injection, and ad review protection natively integrated into 180workspace."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  applicationCategory="BusinessApplication"
>
  <main class="w-full relative">
    
    <AppHero 
      title="Protect ad spend and scale traffic with"
      highlightText="sub-5ms edge evaluation."
      description="Eliminate click fraud, shield ad accounts from competitor spy bots, and route visitors with precision using our zero-latency Cloudflare Edge routing engine."
      breadcrumbs={breadcrumbs}
      primaryCtaText="Launch Traffic Director"
      primaryCtaLink="https://traffic-director.180workspace.com/traffic-director"
      clientId="180_client_39d675390e2ddf3a518b8c436ae665f5"
    />

    <CapabilityPillars 
      sectionBadge="Traffic Director Features"
      sectionTitle="Engineered for media buyers, affiliate pros, and performance agencies."
      sectionSubtitle="Built on Cloudflare global edge network for maximum speed, security, and attribution accuracy."
      pillars={pillars}
    />

    <VideoPlaybook 
      sectionBadge="Setup Playbook"
      title="How to Launch Your First Protected Campaign"
      subtitle="Follow these 4 steps to shield your campaigns and maximize conversion rates."
      videoCaption="2-Minute Traffic Director & Cloaking Walkthrough"
      steps={playbookSteps}
    />

    <WorkGraphSynergy 
      currentAppName="180 Traffic Director"
      title="Edge traffic that feeds your entire sales funnel."
      subtitle="See how real visitor clicks automatically enrich CRM contact records and calculate ad ROI."
      synergies={synergies}
    />

    <FAQAccordion 
      sectionBadge="Traffic Director FAQs"
      title="Frequently Asked Questions about Traffic Director"
      subtitle="Detailed technical answers on latency, bot shielding, custom domains, and platform safety."
      faqs={faqs}
    />

    <AppBottomCTA 
      appName="180 Traffic Director" 
      headline="Stop wasting ad budget on crawlers and bot clicks."
      subheadline="Start protecting your advertising campaigns today. Deploy in under 60 seconds with 180workspace."
      ctaText="Launch Traffic Director"
      ctaLink="https://traffic-director.180workspace.com/traffic-director"
      clientId="180_client_39d675390e2ddf3a518b8c436ae665f5"
    />

    <ProductEcosystemBacklinks currentProduct="traffic-director" />

  </main>
</Layout>
